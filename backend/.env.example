DATABASE_URL=postgresql://sla:sla@localhost:5432/sla
TEST_DATABASE_URL=postgresql://sla:sla@localhost:5432/sla_test
JWT_SECRET=change-me-to-a-long-random-string
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_FALLBACK=
GEMINI_MODEL_REASONING=
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
VECTOR_MIN_SCORE=0.55
LLM_RPM=10
ENABLE_SEARCH_GROUNDING=1
DEMO_MODE=0
DEMO_CARDS=0
LLM_MOCK=0
# comma-separated username:password pairs, e.g. scientist:xxx,analyst:xxx,senior:xxx,admin:xxx
USER_PASSWORDS=
PORT=8010
# development: make the first N AI calls fail with a 429 to prove backoff + model chain
SIMULATE_429=0
# --- research projects
STORAGE_DIR=storage
PROJECT_MAX_UPLOAD_MB=10
# optional: override the cosine gate for project retrieval (defaults to VECTOR_MIN_SCORE)
# PROJECT_MIN_SCORE=0.68
# CORS_ORIGINS=https://lab.example.org
